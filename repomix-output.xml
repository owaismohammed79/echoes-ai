<file path="server/app/services/qa.py">
"""Push-To-Talk question answering.

Implements sections 10.2-10.4 of docs/audio-streaming.md.

Transcription lives in ``services.stt`` and synthesis in ``services.tts``; this
module owns the middle: turning a question plus the walk's cached facts into
**one grounded, validated sentence**, or an honest refusal.

The refusal path is the interesting part. A model told to always cite cannot
answer an out-of-scope question, and the validator will correctly delete
whatever it invents -- leaving silence. So an ungrounded answer is replaced by a
*constant*, never by model output.
"""

from __future__ import annotations

import logging
from dataclasses import dataclass, field
from typing import Any, Sequence

from app.services.prompts import (
    CANNED_REFUSAL,
    QA_INSUFFICIENT,
    QA_SYSTEM,
    build_qa_user_prompt,
)
from app.services.providers import LLMProvider
from app.validation import (
    RejectionReason,
    SentenceAssembler,
    SentenceRejected,
    ValidatedSentence,
    validate_qa_sentence,
)

logger = logging.getLogger("echoes.qa")

#: Cap on past turns handed back to the model. Unbounded history is a latency
#: and cost leak, and a walk's useful follow-up window is short.
MAX_HISTORY_TURNS = 4


@dataclass
class QAResult:
    """The outcome of one Push-To-Talk exchange."""

    transcript: str
    answer: ValidatedSentence | None
    refused: bool = False
    reason: str | None = None
    rejections: list[RejectionReason] = field(default_factory=list)
    error: str | None = None

    @property
    def answer_text(self) -> str:
        """What should be spoken -- the validated answer, or the refusal."""
        if self.answer is not None and self.answer.text:
            return self.answer.text
        return CANNED_REFUSAL

    @property
    def citations(self) -> tuple[str, ...]:
        return self.answer.citations if self.answer else ()

    @property
    def source_urls(self) -> tuple[str, ...]:
        return self.answer.source_urls if self.answer else ()


def trim_history(
    history: Sequence[tuple[str, str]], *, max_turns: int = MAX_HISTORY_TURNS
) -> list[tuple[str, str]]:
    """Keep only the most recent ``max_turns`` (role, text) pairs."""
    if max_turns <= 0:
        return []
    return list(history)[-max_turns:]


def _refusal(
    transcript: str,
    *,
    reason: str,
    rejections: list[RejectionReason] | None = None,
    error: str | None = None,
) -> QAResult:
    return QAResult(
        transcript=transcript,
        answer=None,
        refused=True,
        reason=reason,
        rejections=rejections or [],
        error=error,
    )


async def answer_question(
    *,
    question: str,
    facts: Sequence[Any],
    provider: LLMProvider,
    history: Sequence[tuple[str, str]] = (),
) -> QAResult:
    """Answer ``question`` from ``facts``, or refuse. Never raises.

    ``facts`` is the walk's cached context. An empty list means the walk is in
    Notice Mode, where no question can be grounded -- refusing immediately
    avoids paying for a model call that cannot produce a speakable sentence.
    """
    question = (question or "").strip()
    if not question:
        return _refusal("", reason="empty_transcript")
    if not facts:
        logger.info("PTT with no cached facts; refusing without an LLM call")
        return _refusal(question, reason="no_context")

    id_to_url = {fact.fact_id: getattr(fact, "source_url", "") for fact in facts}

    raw_parts: list[str] = []
    error: str | None = None
    try:
        async for chunk in provider.stream(
            system=QA_SYSTEM,
            user=build_qa_user_prompt(
                facts=facts, question=question, history=trim_history(history)
            ),
        ):
            raw_parts.append(chunk)
    except Exception as exc:  # noqa: BLE001 - a failed answer must not 500 a walk
        error = f"{type(exc).__name__}: {exc}"
        logger.warning("QA generation failed: %s", error)

    raw = "".join(raw_parts).strip()

    # Q5 -- the model's structured escape hatch. Case/whitespace tolerant,
    # because a sentinel that only matches exactly is a sentinel that fails.
    if QA_INSUFFICIENT in raw.upper():
        return _refusal(question, reason="insufficient_facts")

    if not raw:
        return _refusal(question, reason="empty_answer", error=error)

    # Q1 -- one sentence only.
    assembler = SentenceAssembler()
    sentences = assembler.push(raw) + assembler.flush()
    if not sentences:
        return _refusal(question, reason="empty_answer", error=error)

    try:
        validated = validate_qa_sentence(sentences[0], valid_fact_ids=id_to_url)
    except SentenceRejected as rejected:
        logger.info("QA answer rejected (%s): %.120s", rejected.reason, sentences[0])
        return _refusal(
            question,
            reason="ungrounded_answer",
            rejections=[rejected.reason],
            error=error,
        )

    return QAResult(transcript=question, answer=validated, error=error)


__all__ = ["MAX_HISTORY_TURNS", "QAResult", "answer_question", "trim_history"]
</file>

<file path="server/app/services/sessions.py">
"""Per-walk session state: cached facts, conversation history, staleness.

Implements section 11 of docs/audio-streaming.md.

The store is deliberately process-local. That is correct for one instance and
silently wrong for two -- a second instance means a Push-To-Talk request can
land where the session is unknown and the walker hears a refusal for no reason
they can see. ``/api/health`` advertises the limitation rather than letting it
be discovered in production, and section 11 says to fail loudly rather than
quietly degrade.
"""

from __future__ import annotations

import logging
import secrets
import time
from dataclasses import dataclass, field
from typing import Any, Sequence

from app.services.geo import haversine_m

logger = logging.getLogger("echoes.sessions")

SESSION_TTL_SECONDS = 900.0

#: Beyond this distance from where the context was built, the facts no longer
#: describe where the walker is. Answering confidently about a landmark behind
#: them is a grounding failure even though every citation is valid.
STALE_CONTEXT_METRES = 1500.0

MAX_HISTORY_TURNS = 4


@dataclass
class WalkSession:
    """One walk: the facts it was built on, and what has been said since."""

    session_id: str
    facts: list[Any] = field(default_factory=list)
    history: list[tuple[str, str]] = field(default_factory=list)
    anchor: tuple[float, float] | None = None
    created_at: float = 0.0

    def remember(self, role: str, text: str) -> None:
        """Record one turn, keeping only the most recent few.

        Always stores the *validated* text -- if the validator dropped the
        model's sentence and substituted a refusal, the history must show the
        refusal, or the model is primed by its own hallucination next turn
        (docs/audio-streaming.md 10.2).
        """
        if not text:
            return
        self.history.append((role, text))
        self.history = self.history[-(MAX_HISTORY_TURNS * 2) :]


class SessionStore:
    """Process-local session cache with TTL."""

    def __init__(self, *, ttl: float = SESSION_TTL_SECONDS, clock=time.monotonic):
        self._ttl = ttl
        self._clock = clock
        self._sessions: dict[str, WalkSession] = {}

    def create(
        self,
        *,
        facts: Sequence[Any],
        anchor: tuple[float, float] | None = None,
        session_id: str | None = None,
    ) -> WalkSession:
        self._purge()
        session = WalkSession(
            session_id=session_id or secrets.token_urlsafe(16),
            facts=list(facts),
            anchor=anchor,
            created_at=self._clock(),
        )
        self._sessions[session.session_id] = session
        return session

    def get(self, session_id: str | None) -> WalkSession | None:
        self._purge()
        if not session_id:
            return None
        session = self._sessions.get(session_id)
        if session is None:
            return None
        if self._clock() - session.created_at >= self._ttl:
            self._sessions.pop(session_id, None)
            return None
        return session

    def __len__(self) -> int:
        self._purge()
        return len(self._sessions)

    def _purge(self) -> None:
        now = self._clock()
        for key, session in list(self._sessions.items()):
            if now - session.created_at >= self._ttl:
                self._sessions.pop(key, None)


def context_is_stale(
    session: WalkSession, lat: float | None, lon: float | None
) -> bool:
    """True when the walker has moved beyond the context's useful radius.

    Answering confidently about a landmark behind them is a grounding failure
    even when every citation is technically valid
    (docs/audio-streaming.md 10.3).
    """
    if lat is None or lon is None or session.anchor is None:
        return False
    anchor_lat, anchor_lon = session.anchor
    moved = haversine_m(anchor_lat, anchor_lon, lat, lon)
    if moved > STALE_CONTEXT_METRES:
        logger.info("session context stale: walker moved %.0fm", moved)
        return True
    return False


__all__ = [
    "MAX_HISTORY_TURNS",
    "SESSION_TTL_SECONDS",
    "STALE_CONTEXT_METRES",
    "SessionStore",
    "WalkSession",
    "context_is_stale",
]
</file>

<file path="server/app/services/stt.py">
"""Groq Whisper transcription for Push-To-Talk.

Implements section 10.1 of docs/audio-streaming.md.

Groq exposes an OpenAI-compatible endpoint at
``POST {base}/audio/transcriptions``. Verified limits: 25MB (free tier) /
100MB (dev tier), minimum billed length 10 seconds, and a ``prompt`` of up to
224 tokens that can bias the model's spelling of unfamiliar words.

The guards here are the reason this is a separate module from the route: the
upload is attacker-controlled and every rejected clip is a paid API call that
never happens.

NOT verified against the live service: no API key was available.
"""

from __future__ import annotations

import logging
from typing import Final

import httpx

logger = logging.getLogger("echoes.speech.stt")

DEFAULT_BASE_URL = "https://api.groq.com/openai/v1"

#: whisper-large-v3 (10.3% WER) over turbo (12%) because PTT questions are
#: short, so the cost delta is negligible while a mis-heard place name
#: degrades every downstream stage. Configurable via ``GROQ_MODEL``.
DEFAULT_MODEL = "whisper-large-v3"

DEFAULT_TIMEOUT_SECONDS = 20.0

#: Groq bills a minimum of 10 seconds per request regardless of clip length.
MIN_BILLED_SECONDS = 10

#: A PTT question is a few seconds of speech. Anything larger is a client bug
#: or abuse, and must be refused before it reaches a paid endpoint.
MAX_AUDIO_BYTES = 10 * 1024 * 1024

#: Format list confirmed against GroqDocs.
SUPPORTED_CONTENT_TYPES: Final[frozenset[str]] = frozenset(
    {
        "audio/mp4",
        "audio/m4a",
        "audio/x-m4a",
        "audio/mpeg",
        "audio/mpga",
        "audio/wav",
        "audio/x-wav",
        "audio/webm",
        "audio/ogg",
        "audio/flac",
        "video/mp4",
    }
)

#: Whisper's documented prompt ceiling, in tokens. Approximated by characters,
#: which is conservative for short proper nouns.
VOCABULARY_PROMPT_LIMIT = 224


class STTError(RuntimeError):
    """Transcription failed."""


class STTRateLimited(STTError):
    """HTTP 429 from Groq."""


def is_supported_content_type(content_type: str | None) -> bool:
    """True when Groq will accept this upload type."""
    if not content_type:
        return False
    return content_type.split(";")[0].strip().lower() in SUPPORTED_CONTENT_TYPES


def build_vocabulary_prompt(titles: list[str], *, limit: int = VOCABULARY_PROMPT_LIMIT) -> str:
    """Bias Whisper toward the names the walker is standing next to.

    The cheapest available accuracy win for a place-based app: the landmark
    being asked about is already in the fact context, so its correct spelling
    can be seeded rather than guessed from phonetics.
    """
    seen: list[str] = []
    for title in titles:
        title = title.strip()
        if title and title not in seen:
            seen.append(title)
    if not seen:
        return ""
    prompt = ", ".join(seen)
    return prompt[:limit]


class GroqWhisper:
    """Transcribes short PTT clips."""

    def __init__(
        self,
        *,
        api_key: str,
        model: str = DEFAULT_MODEL,
        base_url: str = DEFAULT_BASE_URL,
        timeout: float = DEFAULT_TIMEOUT_SECONDS,
        language: str = "en",
        client: httpx.AsyncClient | None = None,
    ) -> None:
        if not api_key:
            raise ValueError("GroqWhisper requires an API key")
        self._api_key = api_key
        self._model = model
        self._base_url = base_url.rstrip("/")
        self._timeout = timeout
        self._language = language
        self._client = client

    @property
    def endpoint(self) -> str:
        return f"{self._base_url}/audio/transcriptions"

    async def transcribe(
        self,
        *,
        audio: bytes,
        filename: str = "clip.m4a",
        content_type: str = "audio/mp4",
        vocabulary: list[str] | None = None,
    ) -> str:
        """Return the transcript, or raise ``STTError``/``STTRateLimited``.

        Audio is posted straight through and never written to disk
        (docs/audio-streaming.md 10.6).
        """
        data = {
            "model": self._model,
            # Documented to improve both accuracy and latency.
            "language": self._language,
            "response_format": "json",
            "temperature": "0",
        }
        if vocabulary:
            if prompt := build_vocabulary_prompt(vocabulary):
                data["prompt"] = prompt

        headers = {"Authorization": f"Bearer {self._api_key}"}
        files = {"file": (filename, audio, content_type)}

        if self._client is not None:
            return await self._post(self._client, data, files, headers)
        async with httpx.AsyncClient(timeout=self._timeout) as client:
            return await self._post(client, data, files, headers)

    async def _post(
        self,
        client: httpx.AsyncClient,
        data: dict[str, str],
        files: dict[str, tuple[str, bytes, str]],
        headers: dict[str, str],
    ) -> str:
        try:
            response = await client.post(
                self.endpoint, data=data, files=files, headers=headers
            )
        except httpx.HTTPError as exc:
            raise STTError(f"Groq transport failure: {exc}") from exc

        if response.status_code == 429:
            raise STTRateLimited("Groq rate limited the transcription request")
        if response.status_code != 200:
            raise STTError(
                f"Groq returned HTTP {response.status_code}: {response.text[:200]}"
            )

        try:
            payload = response.json()
        except ValueError as exc:
            raise STTError("Groq returned a non-JSON response") from exc

        if error := payload.get("error"):
            raise STTError(f"Groq reported an error: {error}")

        return str(payload.get("text", "")).strip()


__all__ = [
    "DEFAULT_BASE_URL",
    "DEFAULT_MODEL",
    "MAX_AUDIO_BYTES",
    "MIN_BILLED_SECONDS",
    "SUPPORTED_CONTENT_TYPES",
    "STTError",
    "STTRateLimited",
    "GroqWhisper",
    "build_vocabulary_prompt",
    "is_supported_content_type",
]
