<file path="server/app/main.py">
"""Application factory.

Deliberately small: it builds the lifespan (which owns the shared HTTP client
and the service container), applies CORS, mounts the routers, and stops. All
behaviour lives in ``app/services`` and ``app/api``.

``server/main.py`` remains the ASGI entrypoint (``uvicorn main:app``); it simply
calls :func:`create_app`.
"""

from __future__ import annotations

import logging
from contextlib import asynccontextmanager
from typing import AsyncIterator

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from fastapi.staticfiles import StaticFiles

from app.api import api_router
from app.config import ALLOWED_ORIGINS, EXPOSED_HEADERS
from app.dependencies import build_container, create_http_client
from app.services.demo import static_root

logger = logging.getLogger("echoes.app")

DESCRIPTION = (
    "Hyper-local context aggregation and grounded narration for the Echoes "
    "walking companion. Aggregates Wikipedia GeoSearch and SerpApi park data "
    "into FactObject instances with a deterministic STORY/NOTICE routing flag, "
    "then narrates them through a citation validator, a streaming TTS queue, "
    "and a Push-To-Talk question path."
)

VERSION = "0.4.0"


@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncIterator[None]:
    """Own the process-wide resources for the life of the app.

    One connection pool is shared by every outbound call (Wikipedia, SerpApi,
    Gemma, ElevenLabs, Groq) so a walk never pays TCP setup for a second
    dependency.
    """
    async with create_http_client() as client:
        app.state.container = build_container(client)
        logger.info("echoes ready")
        yield
        logger.info("echoes shutting down")


def create_app() -> FastAPI:
    """Build the ASGI application."""
    app = FastAPI(
        title="Echoes API",
        description=DESCRIPTION,
        version=VERSION,
        lifespan=lifespan,
    )

    app.add_middleware(
        CORSMiddleware,
        allow_origins=list(ALLOWED_ORIGINS),
        allow_methods=["GET", "POST", "OPTIONS"],
        allow_headers=["*"],
        # The audio and PTT endpoints return their metadata in headers, so a
        # cross-origin frontend cannot read any of it unless it is exposed.
        expose_headers=list(EXPOSED_HEADERS),
    )

    app.include_router(api_router)

    # Pre-recorded assets: the pedestrian reminder and the demo clips. Plain files
    # on disk, so serving one costs a stat and a read -- no handler, no provider,
    # and no way for a request to turn into a bill. This also makes walk.py's
    # `/static/reminder.wav` reference resolvable, which it was not before: the
    # directory did not exist and nothing mounted it, so that URL 404'd.
    app.mount("/static", StaticFiles(directory=static_root()), name="static")
    return app


__all__ = ["create_app", "lifespan"]
</file>

<file path="server/app/models.py">
"""Shared request and response models.

``FactObject`` is the project's central data contract: it is what the context
aggregator produces, what the prompts are given, and what the validator checks
citations against (AGENTS.md section 1). It lives in its own module so the
services layer can describe it without importing the HTTP layer.
"""

from __future__ import annotations

from pydantic import BaseModel, Field, field_validator


class ContextRequest(BaseModel):
    """Inbound location.

    Coordinates are quantised to 3 decimal places (~100m) as required by
    PRD section 5 (Privacy). The rounding happens in the schema so every
    downstream consumer sees already-quantised values.
    """

    lat: float = Field(..., ge=-90.0, le=90.0, description="Latitude")
    lon: float = Field(..., ge=-180.0, le=180.0, description="Longitude")

    @field_validator("lat", "lon")
    @classmethod
    def _quantise(cls, v: float) -> float:
        """Reduce precision to 3dp so callers cannot submit a precise fix."""
        return round(v, 3)

    model_config = {
        "json_schema_extra": {"example": {"lat": 51.507, "lon": -0.127}}
    }


class FactObject(BaseModel):
    """A single grounded fact. Story Mode may only cite these (AGENTS.md 1)."""

    fact_id: str = Field(..., description="Stable unique identifier for this fact")
    title: str = Field(..., description="Title/heading of the source")
    snippet: str = Field(..., description="Brief excerpt or summary")
    source_url: str = Field(..., description="URL to the original source")
    distance_m: float = Field(
        ..., ge=0.0, description="Distance from the request point, in metres"
    )


class ContextResponse(BaseModel):
    """Structured response: routing flag plus the grounded fact list."""

    mode: str = Field(..., description="Routing decision: 'STORY' or 'NOTICE'")
    facts: list[FactObject] = Field(
        default_factory=list, description="Grounded facts, nearest first"
    )


class WalkRequest(BaseModel):
    """A walk step: where the walker is, and which walk they are continuing."""

    lat: float = Field(..., ge=-90.0, le=90.0)
    lon: float = Field(..., ge=-180.0, le=180.0)
    session_id: str | None = None


__all__ = [
    "ContextRequest",
    "ContextResponse",
    "FactObject",
    "WalkRequest",
]
