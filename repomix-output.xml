<file path="client/src/lib/media-session.ts">
/**
 * Media Session.
 *
 * A walk happens with the phone in a pocket and the screen off, so the lock
 * screen is part of the interface, not an extra: it carries the title and the
 * transport controls that would otherwise require unlocking the device
 * mid-walk.
 *
 * Everything here is feature-detected and swallowed on failure. Safari before
 * 15 has no Media Session at all and several actions are unimplemented
 * elsewhere; `setActionHandler` *throws* for an unsupported action rather than
 * ignoring it, so each binding is guarded separately. A missing lock screen must
 * never take the walk down with it.
 */

const WALK_TITLE = "Echoes Walking Guide";
const WALK_ARTIST = "Echoes";

export interface WalkSessionHandlers {
  onPlay: () => void;
  onPause: () => void;
  onStop: () => void;
}

function session(): MediaSession | undefined {
  if (typeof navigator === "undefined") return undefined;
  return navigator.mediaSession;
}

/** Publish the walk's identity and bind its transport controls. */
export function publishWalkSession(handlers: WalkSessionHandlers): void {
  const ms = session();
  if (!ms) return;

  try {
    const Metadata = (
      window as unknown as { MediaMetadata?: typeof MediaMetadata }
    ).MediaMetadata;
    if (Metadata) {
      ms.metadata = new Metadata({
        title: WALK_TITLE,
        artist: WALK_ARTIST,
        album: "Cited narration",
      });
    }
  } catch {
    /* no metadata support; the controls below may still bind */
  }

  const bind = (action: MediaSessionAction, run: () => void) => {
    try {
      ms.setActionHandler(action, run);
    } catch {
      /* this browser does not implement that action */
    }
  };

  bind("play", handlers.onPlay);
  bind("pause", handlers.onPause);
  bind("stop", handlers.onStop);

  setWalkSessionState("playing");
}

export function setWalkSessionState(
  state: "playing" | "paused" | "none"
): void {
  const ms = session();
  if (!ms) return;
  try {
    ms.playbackState = state;
  } catch {
    /* not settable here */
  }
}

/** Hand the lock screen back when the walk ends. */
export function clearWalkSession(): void {
  const ms = session();
  if (!ms) return;
  const unbind = (action: MediaSessionAction) => {
    try {
      ms.setActionHandler(action, null);
    } catch {
      /* never bound, or unsupported */
    }
  };
  unbind("play");
  unbind("pause");
  unbind("stop");
  try {
    ms.metadata = null;
  } catch {
    /* not settable here */
  }
  setWalkSessionState("none");
}
</file>

<file path="client/src/lib/mic.ts">
/**
 * Push-to-talk capture.
 *
 * RECORDING is a real recording: a `MediaRecorder` over a microphone stream, so
 * the clip handed to `transcribe` is the clip the user actually spoke rather
 * than a timer pretending. Groq's whisper-large-v3 wants a file, and this is it.
 *
 * When the microphone is unavailable the state machine still runs — the user
 * still gets an answer, from the transcript they'd have given anyway — but the
 * failure is *returned* and surfaced on screen. A prompt that says "recording"
 * while nothing is being captured is the same class of lie as a citation
 * without a source.
 */

export interface ClipCapture {
  /** Stop, release the microphone, and hand back what was recorded. */
  stop: () => Promise<Blob | null>;
  /** Drop everything without producing a clip. */
  discard: () => void;
}

export type CaptureStart = ClipCapture | { error: string };

/**
 * A recorder that never fires `stop` must not hang the release: the walk is
 * waiting on this call and the user is standing in the street.
 */
const STOP_TIMEOUT_MS = 1500;

export async function startCapture(): Promise<CaptureStart> {
  const media = navigator.mediaDevices;
  if (!media?.getUserMedia || typeof MediaRecorder === "undefined") {
    return { error: "mic_unsupported" };
  }

  let stream: MediaStream;
  try {
    stream = await media.getUserMedia({ audio: true });
  } catch (error) {
    const name = (error as { name?: string }).name;
    return {
      error:
        name === "NotAllowedError" || name === "SecurityError"
          ? "mic_denied"
          : "mic_unavailable",
    };
  }

  // The microphone light must go out on every path out of here, including the
  // failures below — a walk that leaves the mic open is a privacy bug.
  const release = () => stream.getTracks().forEach((track) => track.stop());

  let recorder: MediaRecorder;
  try {
    recorder = new MediaRecorder(stream);
  } catch {
    release();
    return { error: "mic_unavailable" };
  }

  const chunks: Blob[] = [];
  const stopped = new Promise<void>((resolve) => {
    recorder.onstop = () => resolve();
    recorder.onerror = () => resolve();
  });

  recorder.ondataavailable = (event) => {
    if (event.data && event.data.size > 0) chunks.push(event.data);
  };

  try {
    recorder.start();
  } catch {
    release();
    return { error: "mic_unavailable" };
  }

  const halt = () => {
    try {
      if (recorder.state !== "inactive") recorder.stop();
    } catch {
      /* already stopped */
    }
  };

  return {
    stop: async () => {
      halt();
      await Promise.race([
        stopped,
        new Promise((resolve) => setTimeout(resolve, STOP_TIMEOUT_MS)),
      ]);
      release();
      if (!chunks.length) return null;
      return new Blob(chunks, { type: chunks[0].type || "audio/webm" });
    },
    discard: () => {
      halt();
      release();
    },
  };
}
</file>

