<file path="client/src/components/echoes/push-to-talk.tsx">
import { useCallback } from "react";
import type { PointerEvent as ReactPointerEvent } from "react";

import { GlowingEffect } from "@/components/ui/glowing-effect";
import type { PttState } from "@/hooks/use-walk-controller";
import { cn } from "@/lib/utils";

import { TechLabel } from "./tech-label";

/** Monoline mic. The system allows no illustration and no icon set. */
function MicGlyph({ active }: { active: boolean }) {
  return (
    <svg
      width="22"
      height="22"
      viewBox="0 0 22 22"
      fill="none"
      stroke={active ? "#10B981" : "rgba(250,250,250,0.72)"}
      strokeWidth="1.25"
      strokeLinecap="square"
      aria-hidden="true"
    >
      <rect x="8.25" y="2.5" width="5.5" height="10" rx="1" />
      <path d="M5 10.5a6 6 0 0 0 12 0" />
      <path d="M11 16.5V20" />
    </svg>
  );
}

/** RECORDING: concentric rings leaving the orb. Something is being captured. */
function PulseRings() {
  return (
    <span className="pointer-events-none absolute inset-0" aria-hidden="true">
      {[0, 0.73, 1.46].map((delay) => (
        <span
          key={delay}
          className="animate-pulse-ring absolute inset-0 rounded-full border border-[#10B981] motion-reduce:animate-none"
          style={{ animationDelay: `${delay}s` }}
        />
      ))}
    </span>
  );
}

/** UPLOADING: one hairline arc orbiting the orb. Waiting, not listening. */
function UploadArc() {
  return (
    <svg
      viewBox="0 0 84 84"
      className="animate-sweep pointer-events-none absolute inset-[-6px] h-[84px] w-[84px] origin-center motion-reduce:animate-none"
      aria-hidden="true"
    >
      <circle
        cx="42"
        cy="42"
        r="41"
        fill="none"
        stroke="#10B981"
        strokeWidth="1"
        strokeDasharray="22 236"
      />
    </svg>
  );
}

/** The label the orb carries in each state of its machine. */
const LABELS: Record<PttState, string> = {
  idle: "hold to speak",
  recording: "recording · release to send",
  uploading: "uploading · whisper large v3",
  answering: "answering · grounded",
};

/**
 * Hold to speak. Emerges only once a walk is live, because before that there is
 * nothing on screen worth asking about.
 *
 * The button is the visible half of the PTT machine in use-walk-controller:
 * IDLE -> RECORDING -> UPLOADING -> ANSWERING -> IDLE, each state with its own
 * signal. Recording gets the pulse, because capture is the state the user
 * controls; uploading gets the orbit, because it is the only one they cannot.
 *
 * The aceternity GlowingEffect supplies the border light. Upstream it tracks the
 * pointer and fades out near the element's centre; on a 68px orb under a thumb
 * that would make it invisible exactly when it matters, so `inactiveZone` is 0
 * and the wrapper — not the pointer — decides when the glow is shown.
 */
export function PushToTalk({
  ptt,
  mic,
  onPress,
  onRelease,
}: {
  ptt: PttState;
  /** Why the microphone is unavailable, when it is. */
  mic: string | null;
  onPress: () => void;
  onRelease: () => void;
}) {
  const recording = ptt === "recording";
  const answering = ptt === "answering";
  const uploading = ptt === "uploading";

  const press = useCallback(
    (event: ReactPointerEvent<HTMLButtonElement>) => {
      event.preventDefault();
      try {
        // Capture keeps the hold alive when a thumb slides off the orb. A tap
        // fast enough that the pointer is already gone throws here, and that
        // must not stop the press itself from registering.
        event.currentTarget.setPointerCapture?.(event.pointerId);
      } catch {
        /* pointer already released */
      }
      onPress();
    },
    [onPress]
  );

  const release = useCallback(
    (event: ReactPointerEvent<HTMLButtonElement>) => {
      event.preventDefault();
      onRelease();
    },
    [onRelease]
  );

  // A capture that failed is stated where the user is looking, in the same
  // breath as the state: "recording" over a dead microphone would be a lie.
  const label = recording && mic ? `${mic} · not recording` : LABELS[ptt];

  const border = recording || answering
    ? "#10B981"
    : uploading
      ? "rgba(16,185,129,0.55)"
      : "rgba(250,250,250,0.18)";

  return (
    <div className="mb-[16px] flex flex-col items-center gap-[10px]">
      <div className="relative h-[72px] w-[72px]">
        {recording && <PulseRings />}
        {uploading && <UploadArc />}

        <div
          className={cn(
            "absolute inset-0 rounded-full transition-opacity duration-200",
            recording || answering ? "opacity-100" : "opacity-0"
          )}
        >
          <GlowingEffect
            disabled={false}
            glow
            borderWidth={1}
            spread={24}
            proximity={0}
            inactiveZone={0}
            movementDuration={0.6}
          />
        </div>

        <button
          type="button"
          onPointerDown={press}
          onPointerUp={release}
          onPointerCancel={release}
          onPointerLeave={release}
          onContextMenu={(event) => event.preventDefault()}
          aria-pressed={recording}
          aria-label={recording ? "Release to send" : "Hold to speak"}
          className={cn(
            "relative flex h-full w-full touch-none items-center justify-center rounded-full border bg-[#18181B]",
            "transform-gpu transition-[transform,border-color] duration-150 active:scale-[0.94]"
          )}
          style={{ borderColor: border }}
        >
          <MicGlyph active={recording || answering} />
        </button>
      </div>

      <TechLabel tone={recording || answering ? "accent" : "faint"}>
        {label}
      </TechLabel>
    </div>
  );
}
