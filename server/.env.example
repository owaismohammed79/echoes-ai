GEMMA_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SERPAPI_KEY=
ECHOES_TRUSTED_PROXY_HOPS=

# Keep the ElevenLabs free tier for production. When this is on (the default
# outside a deployed instance), the backend tells clients use_native_tts and
# never calls the provider, even if the keys above are set. Set to 0 in prod.
ECHOES_FORCE_NATIVE_TTS=1