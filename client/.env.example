# The API origin for the real walk engine (lib/real-engine.ts).
#
# Leave it unset in development: Vite proxies /api and /static to
# http://127.0.0.1:8000 (vite.config.ts), so relative URLs just work.
#
# Set it in a deployed client, which is a separate origin from the API, e.g.
# the Render service URL:
VITE_API_BASE_URL=

# Extra hostnames the dev server may answer to, comma-separated and without a
# scheme (e.g. a tunnel you are previewing through):
#
#   VITE_ALLOWED_HOST=my-tunnel.example.com
#
# Vite's own defaults already cover localhost and 127.0.0.1, and
# *.vercel.app is allowed by vite.config.ts, so this is only needed for a host
# outside both. Never a URL: the check compares the request's Host header.
VITE_ALLOWED_HOST=
